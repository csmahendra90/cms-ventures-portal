# Vertex Capital Portal — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vertex-capital?retryWrites=true&w=majority

# Session secret (change this to a random string in production)
SESSION_SECRET=change-this-to-a-random-secret-string

# Port (Replit sets this automatically — don't change)
PORT=3000

# Environment
NODE_ENV=development
